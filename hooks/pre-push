#!/bin/sh
# dev 직접 push를 막는 git hook. dev는 PR 머지(서버에서 일어나 이 hook을 거치지 않는다)로만 바뀐다.
# 사람의 클론에 건다: git config core.hooksPath <kagami>/hooks
# git push가 넘기는 줄(<로컬 ref> <로컬 sha> <원격 ref> <원격 sha>)에서 원격 ref가 dev인 것을 거절한다. 지우기도 포함
while read -r _ _ ref _; do
	if [ "$ref" = refs/heads/dev ]; then
		echo "pre-push: dev에는 직접 push하지 않는다. 잎 브랜치에서 PR로 합친다" >&2
		exit 1
	fi
done
exit 0
